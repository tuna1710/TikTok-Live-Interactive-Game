# ==========================================
# Cấu hình TikTok Live Connector & Bridge
# ==========================================

# Tên tài khoản TikTok đang Live (bỏ dấu @)
# Ví dụ: nếu kênh là @zuno_live thì điền zuno_live
TIKTOK_USERNAME=zuno_live

# Cổng dịch vụ
HTTP_PORT=3000
WS_PORT=8080

# Chế độ giả lập (Mock Mode)
# Đặt true để chạy thử nghiệm tương tác giả lập mà không cần phòng Live TikTok thật
MOCK_MODE=false

# Ngưỡng quy đổi Coin sang hành động trong Chùa Online
GIFT_COIN_INCENSE=1     # 1 Coin (Hoa hồng / Rose): Dâng hương
GIFT_COIN_BOW=5         # 5 Coins: Lễ Phật (Quỳ lạy)
GIFT_COIN_LOTUS=10      # 10+ Coins: Dâng Hoa Sen (Đài sen vàng hào quang)

# Khoảng thời gian giãn cách giữa các lượt hành động của nhân vật (mili-giây)
QUEUE_INTERVAL_MS=3000

# Tùy chọn lọc từ khóa tiêu cực / tục tĩu
ENABLE_PROFANITY_FILTER=true
